---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { business } from '../data/business';
import { withBase, withoutBase } from '../utils/paths';
interface Props { title: string; description: string; image?: string; noindex?: boolean; breadcrumbs?: { name: string; url: string }[]; }
const { title, description, image = '/images/social-preview.png', noindex = false, breadcrumbs = [] } = Astro.props;
const site = Astro.site ?? new URL(business.url);
const canonical = new URL(withBase(withoutBase(Astro.url.pathname)), site).toString();
const fullTitle = title.includes(business.displayName) ? title : title + ' | ' + business.displayName;
const socialImage = new URL(withBase(image), site).toString();
const organization = { '@context': 'https://schema.org', '@type': 'Organization', name: business.displayName, url: new URL(withBase('/'), site).toString(), logo: new URL(withBase(business.logo), site).toString(), email: business.email, telephone: business.phoneE164, address: { '@type': 'PostalAddress', streetAddress: '09, Nagla Duli', addressLocality: business.locality, addressRegion: business.region, addressCountry: business.postalCountry }, description: business.description };
const breadcrumbSchema = breadcrumbs.length ? { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: breadcrumbs.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.name, item: new URL(withBase(item.url), site).toString() })) } : null;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
  <link rel="preload" href={withBase('/fonts/ibm-plex-sans-regular.ttf')} as="font" type="font/ttf" crossorigin />
  <link rel="preload" href={withBase('/fonts/ibm-plex-sans-semibold.ttf')} as="font" type="font/ttf" crossorigin />
  <meta name="theme-color" content="#102d47" />
  {noindex && <meta name="robots" content="noindex,follow" />}
  <meta property="og:type" content="website" /><meta property="og:locale" content="en_IN" />
  <meta property="og:title" content={fullTitle} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
  <meta property="og:image" content={socialImage} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Vyom Enterprises industrial and institutional supplies" /><meta property="og:site_name" content={business.displayName} />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={fullTitle} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={socialImage} />
  <script type="application/ld+json" set:html={JSON.stringify(organization)} />
  {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
</head>
<body><a class="skip-link" href="#main-content">Skip to main content</a><Header /><main id="main-content"><slot /></main><Footer /></body>
</html>

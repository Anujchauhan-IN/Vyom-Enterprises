---
import { business } from '../data/business';
import { withBase } from '../utils/paths';
---
<footer class="footer"><div class="container"><div class="footer-grid">
  <div class="footer-intro"><div class="logo-footer"><img src={withBase(business.logo)} alt="" width="564" height="442" /><div><strong>{business.name}</strong><small class="brand-tag">{business.tagline}</small></div></div><p>{business.description}</p><a class="button button-primary" href={withBase('/request-quotation/')}>Request quotation</a></div>
  <nav aria-labelledby="footer-company"><h2 id="footer-company">Company</h2><a href={withBase('/about/')}>About Us</a><a href={withBase('/capabilities/')}>Capabilities</a><a href={withBase('/products/')}>Products</a><a href={withBase('/contact/')}>Contact Us</a><a href={withBase('/faq/')}>FAQs</a><a href={withBase('/privacy/')}>Privacy Policy</a></nav>
  <div><h2>Contact</h2><a href={'tel:' + business.phoneE164}>{business.phoneDisplay}</a><a href={'https://wa.me/' + business.whatsappNumber} target="_blank" rel="noopener noreferrer">WhatsApp</a><a href={'mailto:' + business.email}>{business.email}</a><p>{business.address}</p></div>
</div><div class="footer-bottom"><span>© {new Date().getFullYear()} Vyom Enterprises.</span><span>Availability, pricing and delivery terms are confirmed before you place an order.</span></div></div></footer>

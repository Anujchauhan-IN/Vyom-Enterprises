---
const { title = 'Tell us what you need.', text = 'Send product details, quantities and the delivery location to request a quote.' } = Astro.props;
---
<section class="section section-navy"><div class="container"><div class="cta"><div><h2 class="subheading">{title}</h2><p>{text}</p></div><div class="hero-actions"><a class="button button-primary" href="/request-quotation/">Request a quotation</a><a class="button button-secondary" href="/contact/">Contact us</a></div></div></div></section>

---
interface Item {label:string;href?:string} const {items=[]}=Astro.props as {items:Item[]};
---
<nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li>{items.map(item=><><li aria-hidden="true">/</li><li>{item.href?<a href={item.href}>{item.label}</a>:<span aria-current="page">{item.label}</span>}</li></>)}</ol></nav>

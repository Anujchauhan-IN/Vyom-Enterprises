---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';
---
<BaseLayout title="Page Not Found" description="The requested page could not be found." noindex={true}>
  <section class="section section-muted not-found"><div class="container not-found-inner"><p class="kicker">Error 404</p><h1 class="display">That page is not in the catalogue.</h1><p class="lead">The address may be incorrect or the page may have moved. Continue to the product catalogue or contact Vyom Enterprises.</p><div class="not-found-actions"><a class="button button-primary" href={withBase('/products/')}>Browse products</a><a class="button button-secondary" href={withBase('/contact/')}>Contact us</a></div></div></section>
</BaseLayout>

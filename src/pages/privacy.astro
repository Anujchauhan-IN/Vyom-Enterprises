---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { business } from '../data/business';
const policyDate = new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date('2026-11-18T00:00:00Z'));
---
<BaseLayout title="Privacy Policy" description="Learn how Vyom Enterprises handles personal and business information shared through enquiries." breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Privacy Policy', url: '/privacy/' }]}>
  <section class="page-hero compact-hero"><div class="container"><Breadcrumbs items={[{ label: 'Privacy Policy' }]} /><h1 class="display">Privacy policy</h1><p class="lead">Learn how Vyom Enterprises collects, uses and handles personal and business information.</p></div></section>
  <section class="section"><div class="container privacy-copy"><p>Last updated: {policyDate}</p><h2>Information we receive</h2><p>When you contact us or request a quotation, you may provide your name, organisation, email address, phone number, delivery location and details about the products you need.</p><h2>How we use your information</h2><p>We use the information you provide to understand your enquiry, discuss product specifications, prepare or coordinate quotations, respond to questions and communicate about possible orders and delivery requirements.</p><h2>WhatsApp and email</h2><p>If you continue through WhatsApp or email, your enquiry is opened in the service you choose. You can review the message before sending it. WhatsApp, your email provider and other communication services handle information according to their own privacy policies.</p><h2>Documents and attachments</h2><p>BOQs, drawings and other documents can be shared directly through WhatsApp or email. Please send only information that is relevant to your enquiry.</p><h2>Website and service providers</h2><p>Our website hosting provider may process standard connection and security information, such as IP addresses, browser details and access logs. We do not use advertising trackers or website analytics.</p><h2>Privacy enquiries</h2><p>To ask about personal or business information shared with Vyom Enterprises, email <a href={'mailto:' + business.email}>{business.email}</a> or call <a href={'tel:' + business.phoneE164}>{business.phoneDisplay}</a>.</p></div></section>
</BaseLayout>
